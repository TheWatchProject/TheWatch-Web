@using Radzen.Blazor

<div class="custody-timeline rz-p-4 rz-border-radius-2" style="background: #1e293b; border: 1px solid #334155;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <div style="font-weight: 700; color: #f8fafc; font-size: 1rem;">Evidence Chain of Custody</div>
        <div style="font-size: 0.75rem; color: #38bdf8; background: rgba(56, 189, 248, 0.15); padding: 3px 8px; border-radius: 4px; border: 1px solid rgba(56, 189, 248, 0.3);">
            SHA-256 Tamper-Evident Ledger
        </div>
    </div>

    @if (Events != null && Events.Any())
    {
        <div style="position: relative; padding-left: 20px; border-left: 2px solid #475569;">
            @foreach (var ev in Events.OrderByDescending(e => e.Timestamp))
            {
                <div style="position: relative; margin-bottom: 16px;">
                    <div style="position: absolute; left: -27px; top: 2px; width: 12px; height: 12px; border-radius: 50%; background: @GetActionColor(ev.Action); border: 2px solid #0f172a;"></div>
                    <div style="display: flex; justify-content: space-between; font-size: 0.85rem;">
                        <span style="font-weight: 600; color: #e2e8f0;">@ev.Action</span>
                        <span style="color: #94a3b8; font-size: 0.75rem;">@ev.Timestamp.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
                    </div>
                    <div style="font-size: 0.8rem; color: #cbd5e1; margin-top: 2px;">@ev.ActorName (@ev.ActorRole)</div>
                    @if (!string.IsNullOrEmpty(ev.Sha256Hash))
                    {
                        <div style="font-family: monospace; font-size: 0.7rem; color: #64748b; margin-top: 2px; word-break: break-all;">
                            Hash: @ev.Sha256Hash
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div style="text-align: center; color: #64748b; font-size: 0.875rem; padding: 16px 0;">
            No custody events recorded.
        </div>
    }
</div>

@code {
    [Parameter] public List<CustodyEventItem> Events { get; set; } = new();

    private string GetActionColor(string action) => action.ToLowerInvariant() switch
    {
        "created" or "uploaded" => "#10b981",
        "legal_hold_placed" => "#ef4444",
        "transferred" => "#f59e0b",
        "verified" => "#38bdf8",
        _ => "#94a3b8"
    };

    public class CustodyEventItem
    {
        public Guid EventId { get; set; } = Guid.NewGuid();
        public string Action { get; set; } = string.Empty;
        public string ActorName { get; set; } = string.Empty;
        public string ActorRole { get; set; } = string.Empty;
        public DateTime Timestamp { get; set; } = DateTime.UtcNow;
        public string? Sha256Hash { get; set; }
    }
}
