<div style="display: flex; align-items: center; gap: 12px; font-size: 0.75rem; color: var(--watch-text-secondary); background: rgba(255,255,255,0.05); padding: 4px 10px; border-radius: 8px; border: 1px solid var(--watch-border);">
    <div style="display: flex; align-items: center; gap: 4px;">
        <span>📶</span>
        <span style="font-weight: 700; color: #60a5fa;">@NetworkType</span>
    </div>
    <div style="width: 1px; height: 12px; background: var(--watch-border);"></div>
    <div style="display: flex; align-items: center; gap: 4px;">
        <span>🔋</span>
        <span style="font-weight: 600; color: @(BatteryLevel > 0.2 ? "#34d399" : "#f87171")">@((int)(BatteryLevel * 100))%</span>
    </div>
</div>

@code {
    [Parameter] public double BatteryLevel { get; set; } = 0.92;
    [Parameter] public bool IsCharging { get; set; } = false;
    [Parameter] public int SignalBars { get; set; } = 4;
    [Parameter] public string NetworkType { get; set; } = "5G";
}
