@using Radzen.Blazor

<div class="rz-p-4 rz-border-radius-2" style="background-color: var(--rz-base-background-color, #1e293b); border: 1px solid #334155; min-width: 220px;">
    <div class="rz-text-caption rz-color-base-400" style="text-transform: uppercase; letter-spacing: 1px;">@Title</div>
    <div class="rz-text-h4 rz-my-2" style="font-weight: 700; color: @MetricColor;">@Value</div>
    <div class="rz-text-body2 rz-color-base-300">
        <span style="color: @(TrendPositive ? "#10b981" : "#ef4444"); font-weight: 600;">@TrendText</span> vs last hour
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Metric";
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string MetricColor { get; set; } = "#38bdf8";
    [Parameter] public string TrendText { get; set; } = "+0%";
    [Parameter] public bool TrendPositive { get; set; } = true;
}
