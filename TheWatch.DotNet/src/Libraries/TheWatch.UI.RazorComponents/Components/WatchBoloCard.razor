@namespace TheWatch.UI.RazorComponents.Components

<div class="watch-bolo-card p-4 rounded-xl border border-amber-500/30 bg-slate-900/90 shadow-lg text-slate-100 mb-4"
     role="alert"
     aria-label="BOLO alert: @Title">
    <div class="flex items-center justify-between border-b border-amber-500/20 pb-2 mb-3">
        <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 text-xs font-black uppercase rounded bg-amber-500 text-slate-950 tracking-wider animate-pulse">BOLO</span>
            <strong class="text-base font-bold text-amber-400">@Title</strong>
        </div>
        @if (IssuedAt.HasValue)
        {
            <span class="text-xs text-slate-400">@IssuedAt.Value.ToString("MMM dd, HH:mm") UTC</span>
        }
    </div>

    <div class="space-y-2 text-sm">
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="text-slate-300">@Description</p>
        }
        @if (!string.IsNullOrWhiteSpace(SubjectDescription))
        {
            <div class="flex gap-2">
                <span class="text-slate-400 font-medium min-w-[80px]">Subject:</span>
                <span class="text-slate-200">@SubjectDescription</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(VehicleDescription))
        {
            <div class="flex gap-2">
                <span class="text-slate-400 font-medium min-w-[80px]">Vehicle:</span>
                <span class="text-slate-200">@VehicleDescription</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(LastSeenLocation))
        {
            <div class="flex gap-2">
                <span class="text-slate-400 font-medium min-w-[80px]">Last Seen:</span>
                <span class="text-amber-300">@LastSeenLocation</span>
            </div>
        }
    </div>

    @if (ChildContent is not null)
    {
        <div class="mt-3 pt-2 border-t border-slate-800 flex justify-end gap-2">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? SubjectDescription { get; set; }

    [Parameter]
    public string? VehicleDescription { get; set; }

    [Parameter]
    public string? LastSeenLocation { get; set; }

    [Parameter]
    public DateTime? IssuedAt { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
