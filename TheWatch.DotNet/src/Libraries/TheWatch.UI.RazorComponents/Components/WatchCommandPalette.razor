@namespace TheWatch.UI.RazorComponents.Components

@if (IsOpen)
{
    <div class="watch-palette-backdrop" @onclick="CloseAsync">
        <div class="watch-palette-modal" @onclick:stopPropagation="true">
            <div class="palette-input-wrapper">
                <span class="palette-search-icon">🔍</span>
                <input type="text"
                       class="palette-input"
                       placeholder="Search actions, responders, emergency zones, or runbooks..."
                       @bind="SearchQuery"
                       @bind:event="oninput"
                       autofocus />
                <kbd class="palette-kbd">ESC</kbd>
            </div>

            <div class="palette-results">
                @if (FilteredCommands.Any())
                {
                    <ul class="palette-list">
                        @foreach (var cmd in FilteredCommands)
                        {
                            <li class="palette-item" @onclick="() => ExecuteCommand(cmd)">
                                <div class="palette-item-icon">@cmd.Icon</div>
                                <div class="palette-item-details">
                                    <div class="palette-item-title">@cmd.Title</div>
                                    <div class="palette-item-desc">@cmd.Description</div>
                                </div>
                                <span class="palette-item-badge">@cmd.Category</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="palette-empty">No matching operational commands found.</div>
                }
            </div>
        </div>
    </div>
}

<style>
    .watch-palette-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.8);
        backdrop-filter: blur(6px);
        z-index: 10000;
        display: flex;
        justify-content: center;
        padding-top: 10vh;
    }
    .watch-palette-modal {
        width: 100%;
        max-width: 36rem;
        background: #1e293b;
        border: 1px solid #475569;
        border-radius: 0.75rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
        overflow: hidden;
        max-height: 70vh;
        display: flex;
        flex-direction: column;
    }
    .palette-input-wrapper {
        display: flex;
        align-items: center;
        padding: 0.875rem 1.25rem;
        border-bottom: 1px solid #334155;
        gap: 0.75rem;
    }
    .palette-search-icon {
        font-size: 1.125rem;
        color: #94a3b8;
    }
    .palette-input {
        flex: 1;
        background: transparent;
        border: none;
        outline: none;
        color: #f8fafc;
        font-size: 1rem;
    }
    .palette-kbd {
        background: #334155;
        color: #94a3b8;
        font-size: 0.75rem;
        padding: 0.2rem 0.4rem;
        border-radius: 0.25rem;
        border: 1px solid #475569;
    }
    .palette-results {
        flex: 1;
        overflow-y: auto;
        padding: 0.5rem;
    }
    .palette-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .palette-item {
        display: flex;
        align-items: center;
        padding: 0.75rem 1rem;
        border-radius: 0.5rem;
        cursor: pointer;
        gap: 0.875rem;
        transition: background 0.15s ease;
    }
    .palette-item:hover {
        background: #334155;
    }
    .palette-item-icon {
        font-size: 1.25rem;
    }
    .palette-item-details {
        flex: 1;
    }
    .palette-item-title {
        color: #f8fafc;
        font-weight: 500;
        font-size: 0.925rem;
    }
    .palette-item-desc {
        color: #94a3b8;
        font-size: 0.75rem;
    }
    .palette-item-badge {
        font-size: 0.7rem;
        padding: 0.2rem 0.4rem;
        border-radius: 0.25rem;
        background: #0f172a;
        color: #38bdf8;
        border: 1px solid #1e293b;
    }
    .palette-empty {
        padding: 2rem;
        text-align: center;
        color: #64748b;
        font-size: 0.875rem;
    }
</style>

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public List<PaletteCommand> Commands { get; set; } = new();

    [Parameter]
    public EventCallback<PaletteCommand> OnCommandExecuted { get; set; }

    private string SearchQuery = "";

    private IEnumerable<PaletteCommand> FilteredCommands =>
        string.IsNullOrWhiteSpace(SearchQuery)
            ? Commands
            : Commands.Where(c => c.Title.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                                  c.Description.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                                  c.Category.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase));

    private async Task CloseAsync()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task ExecuteCommand(PaletteCommand command)
    {
        await OnCommandExecuted.InvokeAsync(command);
        await CloseAsync();
    }

    public sealed record PaletteCommand(string Id, string Title, string Description, string Category, string Icon);
}
