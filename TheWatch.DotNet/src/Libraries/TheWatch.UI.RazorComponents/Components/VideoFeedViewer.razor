@using Radzen.Blazor

<div class="video-feed-card rz-border-radius-2" style="background: #0f172a; border: 1px solid #334155; overflow: hidden; position: relative;">
    <!-- Live Stream Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; background: #1e293b; border-bottom: 1px solid #334155;">
        <div style="display: flex; align-items: center; gap: 8px;">
            <span style="width: 8px; height: 8px; border-radius: 50%; background: @(IsStreaming ? "#ef4444" : "#64748b"); display: inline-block;"></span>
            <span style="font-weight: 700; color: #f8fafc; font-size: 0.875rem;">@StreamTitle</span>
            <span style="font-size: 0.75rem; color: #94a3b8; font-family: monospace;">[@Resolution • @BitrateKbps kbps]</span>
        </div>
        <div>
            @if (IsDuressDetected)
            {
                <span style="background: #ef4444; color: white; font-weight: 700; font-size: 0.75rem; padding: 2px 8px; border-radius: 4px; animation: pulse 1s infinite;">
                    DURESS ACTIVE
                </span>
            }
        </div>
    </div>

    <!-- Video Canvas Container -->
    <div style="height: @Height; display: flex; align-items: center; justify-content: center; background: #020617; position: relative;">
        @if (IsStreaming)
        {
            <div style="text-align: center; color: #94a3b8;">
                <i class="rz-icon" style="font-size: 3rem; color: #ef4444; margin-bottom: 8px;">videocam</i>
                <div style="font-size: 0.875rem; color: #e2e8f0;">WebRTC Secure Video Stream Active</div>
                <div style="font-size: 0.75rem; color: #64748b;">Latency: ~120ms • Encryption: DTLS-SRTP</div>
            </div>
        }
        else
        {
            <div style="text-align: center; color: #64748b;">
                <i class="rz-icon" style="font-size: 3rem; margin-bottom: 8px;">videocam_off</i>
                <div>Stream Standby</div>
            </div>
        }
    </div>

    <!-- Video Controls Footer -->
    <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; background: #1e293b; border-top: 1px solid #334155;">
        <div style="display: flex; gap: 6px;">
            <button class="rz-button rz-button-sm rz-secondary" @onclick="ToggleAudio">
                @(AudioEnabled ? "Mute" : "Unmute")
            </button>
            <button class="rz-button rz-button-sm rz-info" @onclick="Snapshot">
                Snapshot
            </button>
        </div>
        <div>
            <button class="rz-button rz-button-sm rz-danger" @onclick="TriggerManualDuress">
                Flag Duress
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string StreamTitle { get; set; } = "Responder Live Body-Cam";
    [Parameter] public string Height { get; set; } = "280px";
    [Parameter] public bool IsStreaming { get; set; } = true;
    [Parameter] public bool IsDuressDetected { get; set; } = false;
    [Parameter] public string Resolution { get; set; } = "1080p";
    [Parameter] public int BitrateKbps { get; set; } = 2400;
    [Parameter] public EventCallback OnDuressFlagged { get; set; }

    private bool AudioEnabled { get; set; } = true;

    private void ToggleAudio()
    {
        AudioEnabled = !AudioEnabled;
    }

    private void Snapshot()
    {
        // Snapshot callback
    }

    private async Task TriggerManualDuress()
    {
        IsDuressDetected = true;
        if (OnDuressFlagged.HasDelegate)
        {
            await OnDuressFlagged.InvokeAsync();
        }
    }
}
