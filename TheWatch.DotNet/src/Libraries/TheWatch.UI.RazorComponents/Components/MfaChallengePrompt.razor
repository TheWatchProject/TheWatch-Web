@using Radzen.Blazor

@if (IsOpen)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.75); display: flex; align-items: center; justify-content: center; z-index: 9999;">
        <div class="rz-p-6 rz-border-radius-2" style="background: #1e293b; border: 1px solid #334155; max-width: 420px; width: 100%;">
            <div style="font-weight: 700; font-size: 1.1rem; color: #f8fafc; margin-bottom: 8px;">
                @Title
            </div>
            <div style="font-size: 0.875rem; color: #94a3b8; margin-bottom: 16px;">
                @Description
            </div>

            <div style="margin-bottom: 16px;">
                <label style="font-size: 0.8rem; color: #cbd5e1; display: block; margin-bottom: 6px;">6-Digit Security Code / Duress PIN</label>
                <input type="password" maxlength="6" class="rz-textbox" style="width: 100%; text-align: center; font-size: 1.5rem; letter-spacing: 6px;"
                       @bind="Passcode" @bind:event="oninput" />
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 8px;">
                <button class="rz-button rz-secondary" @onclick="Cancel">Cancel</button>
                <button class="rz-button rz-primary" @onclick="VerifyCode" disabled="@(Passcode.Length < 4)">
                    Verify Code
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; } = false;
    [Parameter] public string Title { get; set; } = "Step-Up Authentication Required";
    [Parameter] public string Description { get; set; } = "Enter your authenticator code or PIN to confirm this sensitive action.";
    [Parameter] public EventCallback<string> OnVerified { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private string Passcode { get; set; } = string.Empty;

    private async Task VerifyCode()
    {
        if (OnVerified.HasDelegate)
        {
            await OnVerified.InvokeAsync(Passcode);
        }
        Passcode = string.Empty;
        IsOpen = false;
    }

    private async Task Cancel()
    {
        if (OnCancelled.HasDelegate)
        {
            await OnCancelled.InvokeAsync();
        }
        Passcode = string.Empty;
        IsOpen = false;
    }
}
