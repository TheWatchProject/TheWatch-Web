@page "/forgot-password"
@using System.Net.Http
@using System.Net.Http.Json
@inject NavigationManager Navigation
@inject HttpClient Http

<h3>Forgot Password</h3>
<EditForm Model="model" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="mb-3">
        <label>Email</label>
        <InputText @bind-Value="model.Email" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary" disabled="@isLoading">@((isLoading) ? "Sending..." : "Send Reset Link")</button>
</EditForm>

@code {
    private class Model { public string Email { get; set; } = string.Empty; }
    private Model model = new();
    private bool isLoading = false;
    private async Task HandleSubmit()
    {
        isLoading = true;
        var response = await Http.PostAsJsonAsync("/api/auth/forgot-password", model);
        // In a real app, show a toast/message
        Navigation.NavigateTo("/login");
        isLoading = false;
    }
}
