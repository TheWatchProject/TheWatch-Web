@page "/packages"
@using Radzen.Blazor

<PageTitle>TheWatch Private Package Feed Explorer</PageTitle>

<div class="rz-p-4">
    <RadzenHeading Size="H1" Text="Private NuGet & .wpkg Package Registry" />
    <div class="rz-text-body2 rz-my-2 rz-color-base-300">Internal modular library repository with cryptographic checksum validation.</div>

    <RadzenCard class="rz-my-4">
        <RadzenHeading Size="H3" Text="Available 1.0.0 Packages" />
        <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 12px;">
            <div style="padding: 12px; background: #1e293b; border-radius: 4px;">
                <strong>TheWatch.Geospatial.Db (1.0.0)</strong> - Spatial QuadTree & Cache Store
            </div>
            <div style="padding: 12px; background: #1e293b; border-radius: 4px;">
                <strong>TheWatch.Core.Sensors.Maui (1.0.0)</strong> - MAUI Essentials Sensor Bindings
            </div>
            <div style="padding: 12px; background: #1e293b; border-radius: 4px;">
                <strong>TheWatch.UI.RazorComponents (1.0.0)</strong> - Reusable UI Component Library
            </div>
        </div>
    </RadzenCard>
</div>
